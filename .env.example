# FIXON - WhatsApp order endpoint
#
# Nothing in this file is read by Vercel. It is a list of the variable NAMES the
# endpoint looks for and what each one has to contain. Copy it to .env only if
# you run the function locally; on Vercel the values belong in
# Project -> Settings -> Environment Variables, and .env is git-ignored so a
# token can never end up in the repository by accident.
#
# The values below are placeholders, not examples of real credentials. Fill them
# in from your own Meta and Vercel screens. WHATSAPP-ORDERS.md walks through
# where each one comes from.


# ---------------------------------------------------------------------------
# Required before any order can be delivered. The endpoint reports which of
# these four are still missing (by name, never by value) at
# GET /api/whatsapp-order
# ---------------------------------------------------------------------------

# A permanent access token for a System User of the Meta Business that owns the
# WhatsApp Business Account, with the whatsapp_business_messaging scope.
# Long-lived tokens expire in days, so a temporary one will silently stop the
# orders a week later.
WA_ACCESS_TOKEN=paste-the-permanent-system-user-token

# The WhatsApp Phone Number ID - the number under the phone number you
# registered, NOT the phone number itself. Meta shows it in
# WhatsApp -> API Setup -> "Phone number ID". It is a long digit string.
WA_PHONE_NUMBER_ID=paste-the-phone-number-id

# The number that should RECEIVE the order alerts, in international format,
# digits only, no "+" no spaces. WhatsApp does not deliver a business number's
# own Cloud API message back to itself, so use a staff number or a second
# registered number rather than the sending number.
WA_SHOP_NUMBER=paste-the-recipient-number-digits-only

# Optional. Meta's Graph version to call; the endpoint defaults to v23.0 and
# each version lives about two years. Set it only to pin or to move up.
WA_API_VERSION=v23.0


# ---------------------------------------------------------------------------
# Required for the browser to be allowed to call the endpoint at all
# ---------------------------------------------------------------------------

# Comma-separated list of exact origins that may POST orders. Scheme, host and
# port, with no trailing slash and no path. Anything else gets 403. Include the
# GitHub Pages address, the Vercel address, and localhost while testing.
ORDER_ALLOWED_ORIGINS=https://nihalhussain555.github.io,https://fixon.vercel.app,http://localhost:8123


# ---------------------------------------------------------------------------
# Needed so a product with a relative photo path resolves to a real address
# ---------------------------------------------------------------------------

# Where the site is served from, with the scheme and no trailing slash. A sheet
# cell holding "images/cover.jpg" is turned into this + "/" + that. If a photo
# cell is already a full https:// link, this variable is not used for it.
SITE_URL=https://fixon.example


# ---------------------------------------------------------------------------
# Optional - sensible defaults exist for every one of these
# ---------------------------------------------------------------------------

# Supabase, once the admin dashboard runs the catalog. BOTH or NEITHER: set
# these two and the endpoint re-reads products from the database (what the
# dashboard edits) instead of the CSV below. Unset or half-set and the CSV
# route is used exactly as before - a mis-typed URL falls back rather than
# sending product data somewhere unexpected.
#
# The ANON key only. It is the same public value js/config.js ships to every
# visitor; Row Level Security decides what any key can read, and this read
# sees precisely what a customer sees: active products. The service_role key
# bypasses every policy and must never appear here or in any committed file.
SUPABASE_URL=https://paste-the-project-ref.supabase.co
SUPABASE_ANON_KEY=paste-the-public-anon-key

# The catalog the endpoint re-reads on the server to check a product id, its
# name, price and photo. Defaults to the same live CSV js/catalog.js reads.
# Change it only if you move the sheet or run a fork of this site.
CATALOG_URL=https://raw.githubusercontent.com/nihalhussain555/Fixon/main/data/catalog.csv

# The character used to write a price in the caption. Defaults to the rupee
# sign. This only formats the number that the price column already holds.
PRICE_SYMBOL=₹

# Largest photo the endpoint will fetch and upload, in bytes. WhatsApp caps an
# image message at 5 MB; default is 5242880.
ORDER_MAX_IMAGE_BYTES=5242880

# Orders accepted per visitor IP per 10 minutes. Default is 5. This is a brake
# on a hammered button, not an abuse firewall.
ORDER_RATE_LIMIT=5
